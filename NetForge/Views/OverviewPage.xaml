<Page x:Class="NetForge.Views.OverviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:m="using:NetForge.Models">
  <ScrollViewer>
    <StackPanel Padding="32,28" Spacing="22" MaxWidth="940" HorizontalAlignment="Left">
      <TextBlock x:Uid="Overview_Title" Style="{StaticResource TitleTextBlockStyle}"/>
      <StackPanel Spacing="4" AutomationProperties.LiveSetting="Polite">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock Text="{x:Bind Vm.Glyph, Mode=OneWay}" FontSize="30" Foreground="{x:Bind Vm.StatusBrush, Mode=OneWay}" AutomationProperties.AccessibilityView="Raw"/>
          <TextBlock Text="{x:Bind Vm.Title, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/>
          <ProgressRing IsActive="{x:Bind Vm.IsBusy, Mode=OneWay}" Width="20" Height="20"/>
        </StackPanel>
        <TextBlock Text="{x:Bind Vm.Sub, Mode=OneWay}" Style="{StaticResource Muted}"/>
      </StackPanel>
      <ItemsRepeater ItemsSource="{x:Bind Vm.Items}">
        <ItemsRepeater.Layout><UniformGridLayout MinItemWidth="270" MinRowSpacing="16" MinColumnSpacing="16"/></ItemsRepeater.Layout>
        <DataTemplate x:DataType="m:KeyValue">
          <StackPanel>
            <TextBlock Text="{x:Bind Label}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock Text="{x:Bind Value}" IsTextSelectionEnabled="True" TextWrapping="Wrap"/>
          </StackPanel>
        </DataTemplate>
      </ItemsRepeater>
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button x:Uid="Overview_Run" Style="{StaticResource AccentButtonStyle}" Click="RunDiag_Click"/>
        <Button x:Uid="Overview_Refresh" Click="Refresh_Click"/>
      </StackPanel>
      <StackPanel Spacing="8">
        <TextBlock x:Uid="Overview_Quick" Style="{StaticResource BodyStrongTextBlockStyle}"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Uid="Nav_dns" Tag="dns" Click="Quick_Click"/>
          <Button x:Uid="Nav_ping" Tag="ping" Click="Quick_Click"/>
          <Button x:Uid="Nav_networktest" Tag="networktest" Click="Quick_Click"/>
          <Button x:Uid="Nav_speedtest" Tag="speedtest" Click="Quick_Click"/>
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>
