<Page x:Class="NetForge.Views.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Padding="32,28" Spacing="8" HorizontalAlignment="Left">
    <Image Source="ms-appx:///Assets/NetForge.png" Width="72" Height="72" HorizontalAlignment="Left" AutomationProperties.AccessibilityView="Raw"/>
    <TextBlock Text="NetForge" Style="{StaticResource TitleTextBlockStyle}"/>
    <TextBlock Text="Modern Lightweight Network Toolbox" Style="{StaticResource SubtitleTextBlockStyle}"/>
    <TextBlock Text="Version 1.0.0" Style="{StaticResource Muted}"/>
    <TextBlock Text="Built for Windows." Style="{StaticResource Muted}"/>
    <TextBlock x:Uid="About_Tagline" Margin="0,12,0,0"/>
  </StackPanel>
</Page>
