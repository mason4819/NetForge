<Page x:Class="NetForge.Views.PingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer>
    <StackPanel Padding="32,28" Spacing="14" MaxWidth="940" HorizontalAlignment="Left">
      <TextBlock x:Uid="Ping_Title" Style="{StaticResource TitleTextBlockStyle}"/>
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBox x:Uid="Ping_Target" Width="280" Text="{x:Bind Vm.Target, Mode=TwoWay}"/>
        <NumberBox x:Uid="Ping_Packets" Width="110" Minimum="1" Maximum="100" Value="{x:Bind Vm.Packets, Mode=TwoWay}" SpinButtonPlacementMode="Compact"/>
        <NumberBox x:Uid="Ping_Timeout" Width="130" Minimum="100" Maximum="10000" SmallChange="100" Value="{x:Bind Vm.TimeoutMs, Mode=TwoWay}" SpinButtonPlacementMode="Compact"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button x:Uid="Start" Style="{StaticResource AccentButtonStyle}" Click="Start_Click" IsEnabled="{x:Bind Vm.IsIdle, Mode=OneWay}"/>
        <Button x:Uid="Stop" Click="Stop_Click" IsEnabled="{x:Bind Vm.IsRunning, Mode=OneWay}"/>
      </StackPanel>
      <TextBlock Text="{x:Bind Vm.Note, Mode=OneWay}" Style="{StaticResource Muted}" AutomationProperties.LiveSetting="Polite"/>
      <TextBlock Text="{x:Bind Vm.Error, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
      <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="10" MaxWidth="560">
        <StackPanel><TextBlock x:Uid="Ping_Sent" Style="{StaticResource CaptionTextBlockStyle}"/><TextBlock Text="{x:Bind Vm.Sent, Mode=OneWay}"/></StackPanel>
        <StackPanel Grid.Column="1"><TextBlock x:Uid="Ping_Received" Style="{StaticResource CaptionTextBlockStyle}"/><TextBlock Text="{x:Bind Vm.Received, Mode=OneWay}"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock x:Uid="Ping_Loss" Style="{StaticResource CaptionTextBlockStyle}"/><TextBlock Text="{x:Bind Vm.Loss, Mode=OneWay}"/></StackPanel>
        <StackPanel Grid.Row="1"><TextBlock x:Uid="Ping_Min" Style="{StaticResource CaptionTextBlockStyle}"/><TextBlock Text="{x:Bind Vm.Min, Mode=OneWay}"/></StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="1"><TextBlock x:Uid="Ping_Avg" Style="{StaticResource CaptionTextBlockStyle}"/><TextBlock Text="{x:Bind Vm.Avg, Mode=OneWay}"/></StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="2"><TextBlock x:Uid="Ping_Max" Style="{StaticResource CaptionTextBlockStyle}"/><TextBlock Text="{x:Bind Vm.Max, Mode=OneWay}"/></StackPanel>
      </Grid>
      <ItemsControl ItemsSource="{x:Bind Vm.Lines}">
        <ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{x:Bind}" Style="{StaticResource Mono}"/></DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</Page>
