<Page x:Class="NetForge.Views.TraceroutePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:m="using:NetForge.Models">
  <ScrollViewer>
    <StackPanel Padding="32,28" Spacing="14" MaxWidth="940" HorizontalAlignment="Left">
      <TextBlock x:Uid="Trace_Title" Style="{StaticResource TitleTextBlockStyle}"/>
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBox x:Uid="Ping_Target" Width="320" Text="{x:Bind Vm.Target, Mode=TwoWay}"/>
        <Button x:Uid="Start" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}" Click="Start_Click" IsEnabled="{x:Bind Vm.IsIdle, Mode=OneWay}"/>
        <Button x:Uid="Stop" VerticalAlignment="Bottom" Click="Stop_Click" IsEnabled="{x:Bind Vm.IsRunning, Mode=OneWay}"/>
      </StackPanel>
      <TextBlock Text="{x:Bind Vm.Status, Mode=OneWay}" Style="{StaticResource Muted}" AutomationProperties.LiveSetting="Polite"/>
      <TextBlock Text="{x:Bind Vm.Error, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
      <Grid ColumnDefinitions="48,260,100,*" ColumnSpacing="8">
        <TextBlock x:Uid="Trace_Hop" Style="{StaticResource CaptionTextBlockStyle}"/>
        <TextBlock x:Uid="Trace_Ip" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}"/>
        <TextBlock x:Uid="Trace_Latency" Grid.Column="2" Style="{StaticResource CaptionTextBlockStyle}"/>
        <TextBlock x:Uid="Trace_Host" Grid.Column="3" Style="{StaticResource CaptionTextBlockStyle}"/>
      </Grid>
      <ItemsControl ItemsSource="{x:Bind Vm.Hops}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="m:TraceHop">
            <Grid ColumnDefinitions="48,260,100,*" ColumnSpacing="8" Padding="0,2">
              <TextBlock Text="{x:Bind Hop}"/>
              <TextBlock Grid.Column="1" Text="{x:Bind Address}" IsTextSelectionEnabled="True"/>
              <TextBlock Grid.Column="2" Text="{x:Bind Latency}"/>
              <TextBlock Grid.Column="3" Text="{x:Bind Hostname}" TextTrimming="CharacterEllipsis"/>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</Page>
