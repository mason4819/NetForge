<Page x:Class="NetForge.Views.NetworkTestPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:m="using:NetForge.Models">
  <ScrollViewer>
    <StackPanel Padding="32,28" Spacing="14" MaxWidth="940" HorizontalAlignment="Left">
      <TextBlock x:Uid="Test_Title" Style="{StaticResource TitleTextBlockStyle}"/>
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button x:Uid="Test_Run" Style="{StaticResource AccentButtonStyle}" Click="Run_Click" IsEnabled="{x:Bind Vm.IsIdle, Mode=OneWay}"/>
        <Button x:Uid="Stop" Click="Stop_Click" IsEnabled="{x:Bind Vm.IsRunning, Mode=OneWay}"/>
        <ProgressRing IsActive="{x:Bind Vm.IsRunning, Mode=OneWay}" Width="22" Height="22"/>
      </StackPanel>
      <ItemsControl ItemsSource="{x:Bind Vm.Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="m:TestItem">
            <Grid ColumnDefinitions="140,*,150" ColumnSpacing="12" Padding="0,6" BorderBrush="{ThemeResource NfStrokeBrush}" BorderThickness="0,0,0,1">
              <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
              <TextBlock Grid.Column="1" Text="{x:Bind Detail, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource Muted}"/>
              <TextBlock Grid.Column="2" Text="{x:Bind StateText, Mode=OneWay}" HorizontalAlignment="Right"/>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="{x:Bind Vm.Summary, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
      <StackPanel Orientation="Horizontal" Spacing="10" Visibility="{x:Bind Vm.HasFailure, Mode=OneWay}">
        <Button x:Uid="Test_SwitchDns" Click="SwitchDns_Click"/>
        <Button x:Uid="Test_Again" Click="Run_Click"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>
