<Page x:Class="NetForge.Views.WifiPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:m="using:NetForge.Models">
  <ScrollViewer>
    <StackPanel Padding="32,28" Spacing="16" MaxWidth="940" HorizontalAlignment="Left">
      <TextBlock x:Uid="Wifi_Title" Style="{StaticResource TitleTextBlockStyle}"/>
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button x:Uid="Refresh" Click="Refresh_Click"/>
        <ProgressRing IsActive="{x:Bind Vm.IsBusy, Mode=OneWay}" Width="22" Height="22"/>
      </StackPanel>
      <StackPanel Visibility="{x:Bind Vm.Unavailable, Mode=OneWay}" Spacing="4">
        <TextBlock x:Uid="Wifi_None_T" Style="{StaticResource SubtitleTextBlockStyle}"/>
        <TextBlock x:Uid="Wifi_None_S" Style="{StaticResource Muted}"/>
      </StackPanel>
      <ItemsRepeater ItemsSource="{x:Bind Vm.Items}">
        <ItemsRepeater.Layout><UniformGridLayout MinItemWidth="270" MinRowSpacing="16" MinColumnSpacing="16"/></ItemsRepeater.Layout>
        <DataTemplate x:DataType="m:KeyValue">
          <StackPanel>
            <TextBlock Text="{x:Bind Label}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock Text="{x:Bind Value}" IsTextSelectionEnabled="True" TextWrapping="Wrap"/>
          </StackPanel>
        </DataTemplate>
      </ItemsRepeater>
    </StackPanel>
  </ScrollViewer>
</Page>
