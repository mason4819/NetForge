<Page x:Class="NetForge.Views.AdvancedPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:svc="using:NetForge.Services">
  <Grid Padding="32,28" RowSpacing="12" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto">
    <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}"/>
    <TextBlock x:Name="TipText" Grid.Row="1" Style="{StaticResource Muted}" MaxWidth="760" HorizontalAlignment="Left"/>
    <StackPanel Grid.Row="2" x:Name="Toolbar" Orientation="Horizontal" Spacing="10">
      <Button x:Uid="Refresh" Click="Refresh_Click"/>
      <TextBox x:Uid="Adv_Filter" Width="260" Text="{x:Bind Vm.Filter, Mode=TwoWay}" x:Name="FilterBox"/>
      <ProgressRing IsActive="{x:Bind Vm.IsBusy, Mode=OneWay}" Width="22" Height="22"/>
    </StackPanel>
    <InfoBar Grid.Row="3" IsOpen="{x:Bind Vm.HasResult, Mode=OneWay}" Title="{x:Bind Vm.ResultTitle, Mode=OneWay}" Message="{x:Bind Vm.ResultMessage, Mode=OneWay}" Severity="Informational" IsClosable="True" x:Name="ResultBar"/>
    <ScrollViewer Grid.Row="4" HorizontalScrollBarVisibility="Auto" x:Name="OutputScroll" BorderBrush="{ThemeResource NfStrokeBrush}" BorderThickness="1" Padding="12" Background="{ThemeResource NfSurfaceBrush}">
      <TextBlock Text="{x:Bind Vm.Output, Mode=OneWay}" Style="{StaticResource Mono}"/>
    </ScrollViewer>
    <StackPanel Grid.Row="5" Visibility="{x:Bind Vm.IsEmpty, Mode=OneWay}" Spacing="4">
      <TextBlock x:Uid="Empty_T" Style="{StaticResource SubtitleTextBlockStyle}"/>
      <TextBlock x:Uid="Empty_S" Style="{StaticResource Muted}"/>
    </StackPanel>
    <ItemsRepeater Grid.Row="6" x:Name="ActionList" ItemsSource="{x:Bind Vm.Actions}">
      <ItemsRepeater.Layout><FlowLayout MinRowSpacing="8" MinColumnSpacing="8"/></ItemsRepeater.Layout>
      <DataTemplate x:DataType="svc:AdvAction">
        <Button Content="{x:Bind Label}" Tag="{x:Bind}" Click="Action_Click"/>
      </DataTemplate>
    </ItemsRepeater>
  </Grid>
</Page>
