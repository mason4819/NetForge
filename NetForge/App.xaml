<Application x:Class="NetForge.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
      </ResourceDictionary.MergedDictionaries>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="NfBackgroundBrush" Color="#FAFAFA"/>
          <SolidColorBrush x:Key="NfSurfaceBrush" Color="#F1F1F3"/>
          <SolidColorBrush x:Key="NfStrokeBrush" Color="#E0E0E4"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="NfBackgroundBrush" Color="#1B1B1D"/>
          <SolidColorBrush x:Key="NfSurfaceBrush" Color="#242427"/>
          <SolidColorBrush x:Key="NfStrokeBrush" Color="#38383C"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
          <SolidColorBrush x:Key="NfBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}"/>
          <SolidColorBrush x:Key="NfSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}"/>
          <SolidColorBrush x:Key="NfStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
      </Style>
      <Style x:Key="Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="IsTextSelectionEnabled" Value="True"/>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
